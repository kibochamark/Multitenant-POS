# BullMQ / Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Use `log` locally; set to `whatsapp` only when testing Meta Cloud API.
NOTIFICATION_TRANSPORT=log

# Encrypts user-owned provider credentials stored in PostgreSQL.
# Generate once with: openssl rand -base64 32
NOTIFICATION_CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Scheduling (Africa/Nairobi)
CART_CLEANUP_CRON=0 */5 * * * *
CART_INACTIVITY_MINUTES=30
DAILY_SUMMARY_CRON=0 0 20 * * *
