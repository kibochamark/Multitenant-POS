// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum ShopRole {
  OWNER
  MANAGER
  CASHIER
}

// Polymorphic discriminator used by CartItem / OrderLineItem.itemId,
// which points to either Product.id or Service.id depending on this value.
// Not enforced by a DB foreign key (Prisma can't do polymorphic FKs) —
// this must be validated in the service layer.
enum ItemType {
  PRODUCT
  SERVICE
}

enum DiscountType {
  PERCENT
  FLAT
}

enum StockMovementType {
  SALE
  RESTOCK
  WRITE_OFF
  REFUND
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum OrderStatus {
  OPEN // cart just converted, awaiting payment
  PENDING // one or more payment allocations still await confirmation
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum OrderRefundStatus {
  NONE
  PARTIAL
  FULL
}

enum RefundDisposition {
  RESTOCK
  DAMAGED
  NOT_RETURNED
}

enum CartStatus {
  ACTIVE
  COMPLETED // converted into an Order
  ABANDONED // auto-expired by the cron cleanup job
}

// Assumption: cash, mpesa, and bank transfer as the three payment rails, plus
// CREDIT for sales settled against a customer's account rather than collected now.
enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CREDIT
}

// Reflects the manual "customer sends money, staff records + later confirms" workflow.
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

// MANUAL: staff types in a reference code and reconciles it against the Safaricom
// business statement by hand. STK_PUSH: Daraja API push, confirmed automatically
// via callback. Same Payment/PaymentStatus model serves both — this just tags how
// confirmation happens.
enum PaymentChannel {
  MANUAL
  STK_PUSH
}

enum MpesaAccountType {
  TILL
  PAYBILL
}

// Mirrors StockMovementType — an append-only ledger for a customer's debt.
// Positive amount = balance increases (they owe more), negative = balance decreases (they paid).
enum CreditTransactionType {
  CREDIT_SALE
  REPAYMENT
  REFUND
  ADJUSTMENT
}

enum NotificationType {
  LOW_STOCK
  BELOW_FLOOR_DISCOUNT
  CART_ABANDONED
  EXPENSE_LOGGED
  PAYMENT_PENDING
  CREDIT_LIMIT_EXCEEDED
  CREDIT_OVERDUE
  DAILY_SUMMARY
  GENERIC
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum NotificationTemplateStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountScope {
  COMPANY
  SHOP
  CUSTOMER
}

// AccountType explains the accounting category; AccountPurpose identifies the
// exact operational account that application workflows must post against.
enum AccountPurpose {
  CASH_ON_HAND
  MPESA
  BANK
  CUSTOMER_RECEIVABLE
  INVENTORY
  VAT_PAYABLE
  OWNER_CAPITAL
  OWNER_DRAWINGS
  PRODUCT_REVENUE
  SERVICE_REVENUE
  SALES_RETURNS
  COST_OF_GOODS_SOLD
  GENERAL_EXPENSE
  CASH_OVER_SHORT
  UNALLOCATED_INVENTORY_COST
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSide {
  DEBIT
  CREDIT
}

enum AccountingEventType {
  OPENING_BALANCE
  SALE
  CASH_SALE
  MPESA_SALE
  CREDIT_SALE
  SERVICE_SALE
  CUSTOMER_REPAYMENT
  EXPENSE
  INVENTORY_PURCHASE
  REFUND
  WRITE_OFF
  STOCK_ADJUSTMENT
  ORDER_CANCELLATION
  MANUAL_ADJUSTMENT
}

enum AccountingSourceType {
  ORDER
  ORDER_CANCELLATION
  PAYMENT
  CREDIT_TRANSACTION
  CREDIT_REPAYMENT
  EXPENSE
  REFUND
  REFUND_PAYMENT
  STOCK_MOVEMENT
  INVENTORY_PURCHASE
  MANUAL_JOURNAL
  SHOP_DAILY_ACCOUNT
}

// ─────────────────────────────────────────────────────────
// TENANCY: COMPANY → SHOP → STAFF
// ─────────────────────────────────────────────────────────

model Company {
  id                  String   @id @default(uuid())
  name                String
  vatPct              Float    @default(0)
  defaultMinMarginPct Float    @default(0) // fallback profit floor, overridable per-Product
  globalDiscountPct   Float    @default(0) // default discount applied unless overridden at line-item level
  metadata            Json? // catch-all for anything company-specific that doesn't need its own column
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shops             Shop[]
  users             User[]
  customers         Customer[]
  accounts          Account[]
  accountingPeriods AccountingPeriod[]
  journalEntries    JournalEntry[]

  @@map("companies")
}

model Shop {
  id                  String   @id @default(uuid())
  companyId           String
  name                String
  vatPct              Float? // null inherits Company.vatPct; zero is an explicit zero-VAT override
  defaultMinMarginPct Float? // null inherits Company.defaultMinMarginPct
  globalDiscountPct   Float? // null inherits Company.globalDiscountPct
  metadata            Json? // catch-all for anything shop-specific that doesn't need its own column
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company        Company            @relation(fields: [companyId], references: [id])
  products       Product[]
  services       Service[]
  carts          Cart[]
  orders         Order[]
  expenses       Expense[]
  writeOffs      WriteOff[]
  userRoles      UserShopRole[]
  notifications  Notification[]
  mpesaAccounts  MpesaAccount[]
  dailyAccounts  ShopDailyAccount[]
  accounts       Account[]
  journalEntries JournalEntry[]

  @@index([companyId])
  @@map("shops")
}

// One row per Kinde-authenticated person. All other tables reference User.id,
// never kinde_id directly — insulates the schema from any future auth changes.
model User {
  id           String   @id @default(uuid())
  companyId    String
  kindeId      String   @unique
  name         String
  email        String   @unique
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  defaultOwner Boolean  @default(false) @map("defaulOwner") // true for the first user created in a company, false for all others
  isActive     Boolean  @default(true)

  company                  Company                     @relation(fields: [companyId], references: [id])
  shopRoles                UserShopRole[]
  ordersHandled            Order[]                     @relation("OrderStaff")
  cartsHandled             Cart[]                      @relation("CartStaff")
  cartDiscountsApplied     CartItem[]                  @relation("CartDiscountAppliedBy")
  writeOffs                WriteOff[]                  @relation("WriteOffStaff")
  refundsIssued            Refund[]                    @relation("RefundStaff")
  expensesRecorded         Expense[]                   @relation("ExpenseRecordedBy")
  servicesRecorded         Service[]                   @relation("ServiceCreatedBy")
  stockMovementsRecorded   StockMovement[]
  paymentsRecorded         Payment[]                   @relation("PaymentRecordedBy")
  paymentsVerified         Payment[]                   @relation("PaymentVerifiedBy")
  discountsApplied         OrderLineItem[]             @relation("DiscountAppliedBy")
  creditTransactionsLogged CreditTransaction[]         @relation("CreditTransactionRecordedBy")
  creditRepaymentsRecorded CreditRepayment[]           @relation("CreditRepaymentRecordedBy")
  creditRepaymentsVerified CreditRepayment[]           @relation("CreditRepaymentVerifiedBy")
  creditLimitsChanged      CustomerCreditLimitChange[] @relation("CreditLimitChangedBy")
  ordersCancelled          OrderCancellation[]         @relation("OrderCancelledBy")
  refundPaymentsRecorded   RefundPayment[]             @relation("RefundPaymentRecordedBy")
  notificationPreference   NotificationPreference?
  notificationChannels     UserNotificationChannel[]
  notificationTemplates    NotificationTemplate[]
  notificationDeliveries   NotificationDelivery[]
  notificationRecipients   NotificationRecipient[]
  dailyAccountsRecorded    ShopDailyAccount[]          @relation("DailyAccountRecordedBy")
  journalEntriesRecorded   JournalEntry[]              @relation("JournalEntryRecordedBy")
  accountingPeriodsClosed  AccountingPeriod[]          @relation("AccountingPeriodClosedBy")

  @@index([companyId])
  @@map("users")
}

// Many-to-many: a user can hold a different role at each shop they work.
model UserShopRole {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  role      ShopRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([userId, shopId])
  @@index([shopId])
  @@map("user_shop_roles")
}

// ─────────────────────────────────────────────────────────
// CATALOG: PRODUCTS & SERVICES (per-shop, not shared)
// ─────────────────────────────────────────────────────────

model Product {
  id                String   @id @default(uuid())
  shopId            String
  name              String
  barcode           String
  price             Decimal  @db.Decimal(12, 2) // tag / list price
  costPrice         Decimal  @db.Decimal(12, 2)
  minMarginPct      Float? // overrides Company.defaultMinMarginPct when set
  minPrice          Decimal? @db.Decimal(12, 2) // explicit floor override; takes precedence over minMarginPct if set
  lowStockThreshold Int      @default(5)
  category          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  stockCache     StockCache?
  stockMovements StockMovement[]
  writeOffs      WriteOff[]

  @@unique([shopId, barcode]) // barcode is unique per shop, not globally
  @@index([shopId])
  @@index([shopId, createdAt, id])
  @@map("products")
}

// Fast-read cache of current stock, kept in sync with StockMovement inserts
// inside the same DB transaction. StockMovement remains the source of truth.
model StockCache {
  id              String   @id @default(uuid())
  productId       String   @unique
  currentQuantity Int      @default(0)
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_cache")
}

// Append-only ledger. Never updated or deleted — always insert a new row.
model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  quantityDelta Int // negative for sales/write-offs, positive for restocks/refunds
  type          StockMovementType
  referenceId   String? // points to the Order, WriteOff, or Refund that caused this
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdById])
  @@index([type])
  @@map("stock_movements")
}

// Income-generating actions that aren't physical product sales
// (e.g. printing, browsing, repairs, software installs).
model Service {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  shop      Shop  @relation(fields: [shopId], references: [id])
  createdBy User? @relation("ServiceCreatedBy", fields: [createdById], references: [id])

  @@index([shopId])
  @@index([createdById])
  @@index([shopId, createdAt, id])
  @@map("services")
}

// ─────────────────────────────────────────────────────────
// CUSTOMERS & CREDIT (accounts receivable)
// ─────────────────────────────────────────────────────────

// Only needed for customers you extend credit to, or otherwise want to track —
// anonymous walk-in cash/mpesa sales don't require a Customer at all.
model Customer {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  phone       String?
  email       String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company                     @relation(fields: [companyId], references: [id])
  orders             Order[]
  creditAccount      CreditAccountCache?
  creditTransactions CreditTransaction[]
  creditRepayments   CreditRepayment[]
  creditLimitChanges CustomerCreditLimitChange[]
  accounts           Account[]

  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@index([companyId])
  @@map("customers")
}

// Fast-read cache of what a customer currently owes, kept in sync with
// CreditTransaction inserts inside the same DB transaction — same pattern as StockCache.
model CreditAccountCache {
  id             String   @id @default(uuid())
  customerId     String   @unique
  currentBalance Decimal  @default(0) @db.Decimal(12, 2) // positive = amount the customer owes the shop
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("credit_account_cache")
}

// Immutable audit trail for every manager/owner credit-limit decision.
model CustomerCreditLimitChange {
  id            String   @id @default(uuid())
  customerId    String
  previousLimit Decimal  @db.Decimal(12, 2)
  newLimit      Decimal  @db.Decimal(12, 2)
  reason        String
  changedById   String
  createdAt     DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  changedBy User     @relation("CreditLimitChangedBy", fields: [changedById], references: [id])

  @@index([customerId, createdAt])
  @@index([changedById])
  @@map("customer_credit_limit_changes")
}

// Append-only ledger. Never updated or deleted — always insert a new row.
// A CREDIT_SALE row is created the moment an Order is settled via PaymentMethod.CREDIT.
// REPAYMENT rows come from a confirmed CreditRepayment. Not tied 1:1 to a single
// Order, since a customer's repayment often pays down several orders at once.
model CreditTransaction {
  id           String                @id @default(uuid())
  customerId   String
  orderId      String? // set for CREDIT_SALE, null for REPAYMENT/ADJUSTMENT
  refundId     String?
  type         CreditTransactionType
  amount       Decimal               @db.Decimal(12, 2) // positive increases balance owed, negative decreases it
  dueDate      DateTime? // optional follow-up date, set on CREDIT_SALE
  note         String?
  recordedById String?
  createdAt    DateTime              @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])
  refund     Refund?  @relation(fields: [refundId], references: [id])
  recordedBy User?    @relation("CreditTransactionRecordedBy", fields: [recordedById], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([refundId])
  @@map("credit_transactions")
}

// A customer paying down their balance. Same manual-verification shape as Payment,
// since a repayment via M-Pesa needs the same reference-code reconciliation.
// Service layer should restrict `method` to CASH / MPESA / BANK_TRANSFER (not CREDIT).
model CreditRepayment {
  id            String         @id @default(uuid())
  customerId    String
  amount        Float
  method        PaymentMethod
  channel       PaymentChannel @default(MANUAL)
  referenceCode String?
  note          String?
  failureReason String?
  status        PaymentStatus  @default(PENDING)
  recordedById  String
  verifiedById  String?
  verifiedAt    DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime       @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User     @relation("CreditRepaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedBy User?    @relation("CreditRepaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@index([customerId])
  @@map("credit_repayments")
}

// ─────────────────────────────────────────────────────────
// CART (persisted, converts into an Order at checkout)
// ─────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(uuid())
  shopId    String
  staffId   String
  stationId String     @default("legacy")
  activeKey String?    @unique // shop:staff:station while ACTIVE; cleared when completed/abandoned
  status    CartStatus @default(ACTIVE)
  orderId   String?    @unique // set once this cart converts into an Order
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt // must be bumped on every item add/remove — the cron job keys off this

  shop  Shop       @relation(fields: [shopId], references: [id])
  staff User       @relation("CartStaff", fields: [staffId], references: [id])
  order Order?     @relation(fields: [orderId], references: [id])
  items CartItem[]

  @@index([shopId, status])
  @@index([shopId, staffId, stationId, status])
  @@map("carts")
}

// The Safaricom till/paybill a shop collects payments into. Reconciliation staff
// use accountNumber to know which statement to check a referenceCode against.
// NOTE: Daraja API credentials (consumer key/secret, passkey) must NOT live here —
// keep those in env vars / a secrets manager, never in the database.
model MpesaAccount {
  id            String           @id @default(uuid())
  shopId        String
  accountType   MpesaAccountType
  accountNumber String // the till or paybill number itself
  label         String? // e.g. "Main till", "Repairs paybill"
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@map("mpesa_accounts")
}

model CartItem {
  id                  String        @id @default(uuid())
  cartId              String
  itemType            ItemType
  itemId              String // Product.id or Service.id depending on itemType
  quantity            Int           @default(1)
  originalUnitPrice   Decimal       @db.Decimal(12, 2)
  discountType        DiscountType?
  discountValue       Decimal?      @db.Decimal(12, 2)
  finalUnitPrice      Decimal       @db.Decimal(12, 2)
  belowFloor          Boolean       @default(false)
  discountReason      String?
  discountAppliedById String?
  createdAt           DateTime      @default(now())

  cart              Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  discountAppliedBy User? @relation("CartDiscountAppliedBy", fields: [discountAppliedById], references: [id])

  @@unique([cartId, itemType, itemId])
  @@index([cartId])
  @@index([discountAppliedById])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────
// ORDERS (immutable once created — snapshot of the cart at checkout)
// ─────────────────────────────────────────────────────────

model Order {
  id             String            @id @default(uuid())
  shopId         String
  staffId        String
  customerId     String? // required at the service layer whenever any Payment.method = CREDIT
  status         OrderStatus       @default(OPEN)
  subtotal       Decimal           @db.Decimal(12, 2)
  vatAmount      Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @db.Decimal(12, 2)
  amountPaid     Decimal           @default(0) @db.Decimal(12, 2) // sum of CONFIRMED payments, kept in sync on payment writes
  refundedAmount Decimal           @default(0) @db.Decimal(12, 2)
  refundStatus   OrderRefundStatus @default(NONE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  shop               Shop                @relation(fields: [shopId], references: [id])
  staff              User                @relation("OrderStaff", fields: [staffId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  cart               Cart?
  lineItems          OrderLineItem[]
  payments           Payment[]
  refunds            Refund[]
  creditTransactions CreditTransaction[]
  cancellation       OrderCancellation?

  @@index([shopId, status])
  @@index([customerId])
  @@map("orders")
}

// Immutable audit record for reversing an unpaid checked-out order. The
// one-to-one orderId constraint makes cancellation idempotent.
model OrderCancellation {
  id            String   @id @default(uuid())
  orderId       String   @unique
  reason        String
  cancelledById String
  createdAt     DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id])
  cancelledBy User  @relation("OrderCancelledBy", fields: [cancelledById], references: [id])

  @@index([cancelledById])
  @@map("order_cancellations")
}

model OrderLineItem {
  id                  String        @id @default(uuid())
  orderId             String
  itemType            ItemType
  itemId              String // Product.id or Service.id depending on itemType
  quantity            Int
  originalUnitPrice   Decimal       @db.Decimal(12, 2) // snapshot of tag price at time of sale
  discountType        DiscountType?
  discountValue       Decimal?      @db.Decimal(12, 2)
  finalUnitPrice      Decimal       @db.Decimal(12, 2)
  lineTotal           Decimal       @db.Decimal(12, 2)
  belowFloor          Boolean       @default(false) // true if finalUnitPrice < computed profit floor
  discountReason      String?
  discountAppliedById String?
  createdAt           DateTime      @default(now())

  order             Order            @relation(fields: [orderId], references: [id])
  discountAppliedBy User?            @relation("DiscountAppliedBy", fields: [discountAppliedById], references: [id])
  refundLineItems   RefundLineItem[]

  @@index([orderId])
  @@map("order_line_items")
}

// ─────────────────────────────────────────────────────────
// PAYMENTS (cash / mpesa / bank transfer, split payments supported)
// ─────────────────────────────────────────────────────────

model Payment {
  id            String         @id @default(uuid())
  orderId       String
  method        PaymentMethod
  channel       PaymentChannel @default(MANUAL)
  amount        Decimal        @db.Decimal(12, 2)
  status        PaymentStatus  @default(PENDING)
  referenceCode String? // MANUAL: code the customer reads out from their M-Pesa SMS

  recordedById String // staff who logged the payment (took the code from the customer)
  verifiedById String? // MANUAL only: staff/owner who cross-checked it against the Safaricom statement
  verifiedAt   DateTime? // when that reconciliation happened

  // STK_PUSH only — populated by the Daraja API callback once that flow exists
  stkCheckoutRequestId String?
  stkMerchantRequestId String?
  stkResultCode        String?
  stkResultDesc        String?

  confirmedAt   DateTime? // set the moment status becomes CONFIRMED, regardless of channel
  failureReason String?
  createdAt     DateTime  @default(now())

  order      Order @relation(fields: [orderId], references: [id])
  recordedBy User  @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedBy User? @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@index([orderId])
  @@index([method, status])
  @@index([referenceCode])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────
// REFUNDS & WRITE-OFFS
// ─────────────────────────────────────────────────────────

model Refund {
  id          String   @id @default(uuid())
  orderId     String
  staffId     String
  reason      String
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order              Order               @relation(fields: [orderId], references: [id])
  staff              User                @relation("RefundStaff", fields: [staffId], references: [id])
  lineItems          RefundLineItem[]
  payments           RefundPayment[]
  creditTransactions CreditTransaction[]

  @@index([orderId])
  @@map("refunds")
}

// Supports partial refunds — refunding some line items/quantities but not others.
model RefundLineItem {
  id              String            @id @default(uuid())
  refundId        String
  orderLineItemId String
  quantity        Int
  amount          Decimal           @db.Decimal(12, 2)
  disposition     RefundDisposition

  refund        Refund        @relation(fields: [refundId], references: [id])
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id])

  @@index([refundId])
  @@map("refund_line_items")
}

// Money leaving Dantech after a paid sale is separate from the original
// incoming Payment. Credit reversals use CreditTransaction(type: REFUND).
model RefundPayment {
  id            String        @id @default(uuid())
  refundId      String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus
  referenceCode String?
  recordedById  String
  confirmedAt   DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())

  refund     Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  recordedBy User   @relation("RefundPaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([refundId])
  @@index([method, status, createdAt])
  @@index([referenceCode])
  @@map("refund_payments")
}

// Stock leaving inventory outside of a sale (damaged, expired, lost, theft).
// Not tied to an Order — writes directly to the StockMovement ledger.
model WriteOff {
  id        String   @id @default(uuid())
  shopId    String
  productId String
  staffId   String
  quantity  Int
  reason    String
  note      String?
  createdAt DateTime @default(now())

  shop    Shop    @relation(fields: [shopId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  staff   User    @relation("WriteOffStaff", fields: [staffId], references: [id])

  @@index([shopId])
  @@index([productId])
  @@map("write_offs")
}

// ─────────────────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────────────────

model Expense {
  id             String        @id @default(uuid())
  shopId         String
  recordedById   String // who
  amount         Decimal       @db.Decimal(12, 2) // how much
  category       String // e.g. "Rent", "Utilities", "Supplier restock", "Repairs"
  description    String // why
  paymentMethod  PaymentMethod @default(CASH)
  mpesaReference String?
  createdAt      DateTime      @default(now())

  shop       Shop @relation(fields: [shopId], references: [id])
  recordedBy User @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  @@index([shopId])
  @@index([shopId, createdAt, id])
  @@index([category])
  @@index([shopId, paymentMethod, createdAt])
  @@map("expenses")
}

// One opening balance per shop and business day. Everything else in the
// accounts view is derived from immutable orders, payments, credit, and expenses.
model ShopDailyAccount {
  id           String   @id @default(uuid())
  shopId       String
  businessDate DateTime @db.Date
  openingCash  Decimal  @default(0) @db.Decimal(12, 2)
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  recordedBy User @relation("DailyAccountRecordedBy", fields: [recordedById], references: [id])

  @@unique([shopId, businessDate])
  @@index([shopId, businessDate])
  @@map("shop_daily_accounts")
}

// ─────────────────────────────────────────────────────────
// ACCOUNTING LEDGER & BALANCE CACHES
// ─────────────────────────────────────────────────────────

// A labelled financial bucket. Parent accounts group reporting categories;
// journal entries should normally post only to leaf accounts.
model Account {
  id          String          @id @default(uuid())
  companyId   String
  shopId      String?
  customerId  String?
  code        String
  name        String
  type        AccountType
  scope       AccountScope
  purpose     AccountPurpose?
  parentId    String?
  description String?
  isSystem    Boolean         @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company       Company               @relation(fields: [companyId], references: [id])
  shop          Shop?                 @relation(fields: [shopId], references: [id])
  customer      Customer?             @relation(fields: [customerId], references: [id])
  parent        Account?              @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]             @relation("AccountHierarchy")
  journalLines  JournalLine[]
  balanceCache  AccountBalanceCache?
  dailyBalances AccountDailyBalance[]

  @@unique([companyId, code])
  @@unique([shopId, purpose])
  @@index([companyId, type, isActive])
  @@index([shopId])
  @@index([customerId])
  @@index([parentId])
  @@map("accounts")
}

// A company accounting window. Closed/locked periods prevent historical
// transactions from being silently changed after reporting.
model AccountingPeriod {
  id         String                 @id @default(uuid())
  companyId  String
  name       String
  startsAt   DateTime               @db.Date
  endsAt     DateTime               @db.Date
  status     AccountingPeriodStatus @default(OPEN)
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  closedBy User?          @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  entries  JournalEntry[]

  @@unique([companyId, startsAt, endsAt])
  @@index([companyId, status])
  @@map("accounting_periods")
}

// One complete business event. POSTED entries must have equal debit and credit
// totals; reversals create another entry rather than mutating history.
model JournalEntry {
  id              String              @id @default(uuid())
  companyId       String
  shopId          String?
  periodId        String?
  entryNumber     String
  eventType       AccountingEventType
  transactionDate DateTime
  description     String
  status          JournalEntryStatus  @default(DRAFT)
  recordedById    String
  postedAt        DateTime?
  reversedAt      DateTime?
  reversalOfId    String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company     Company               @relation(fields: [companyId], references: [id])
  shop        Shop?                 @relation(fields: [shopId], references: [id])
  period      AccountingPeriod?     @relation(fields: [periodId], references: [id])
  recordedBy  User                  @relation("JournalEntryRecordedBy", fields: [recordedById], references: [id])
  reversalOf  JournalEntry?         @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversal    JournalEntry?         @relation("JournalReversal")
  lines       JournalLine[]
  sourceLinks AccountingEventLink[]

  @@unique([companyId, entryNumber])
  @@index([companyId, transactionDate])
  @@index([shopId, transactionDate])
  @@index([periodId, status])
  @@index([eventType])
  @@map("journal_entries")
}

// One debit or credit side of a journal entry. A single side column prevents a
// malformed line from containing both debit and credit amounts.
model JournalLine {
  id          String      @id @default(uuid())
  entryId     String
  accountId   String
  side        JournalSide
  amount      Decimal     @db.Decimal(16, 2)
  description String?
  createdAt   DateTime    @default(now())

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// Connects the generic ledger to an order/payment/expense/etc. The unique
// source prevents the same business event from being posted twice.
model AccountingEventLink {
  id         String               @id @default(uuid())
  entryId    String
  sourceType AccountingSourceType
  sourceId   String
  createdAt  DateTime             @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id])

  @@unique([sourceType, sourceId])
  @@index([entryId])
  @@map("accounting_event_links")
}

// Fast current balance. `balance` always uses the universal signed formula:
// totalDebit - totalCredit. JournalLine remains the source of truth.
model AccountBalanceCache {
  id          String   @id @default(uuid())
  accountId   String   @unique
  totalDebit  Decimal  @default(0) @db.Decimal(16, 2)
  totalCredit Decimal  @default(0) @db.Decimal(16, 2)
  balance     Decimal  @default(0) @db.Decimal(16, 2)
  lastEntryId String?
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([lastEntryId])
  @@map("account_balance_caches")
}

// Historical daily movement cache used for opening/closing balances and date
// range reports. It can be rebuilt from POSTED journal lines.
model AccountDailyBalance {
  id             String   @id @default(uuid())
  accountId      String
  businessDate   DateTime @db.Date
  openingBalance Decimal  @default(0) @db.Decimal(16, 2)
  debitMovement  Decimal  @default(0) @db.Decimal(16, 2)
  creditMovement Decimal  @default(0) @db.Decimal(16, 2)
  closingBalance Decimal  @default(0) @db.Decimal(16, 2)
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, businessDate])
  @@index([businessDate])
  @@map("account_daily_balances")
}

// ─────────────────────────────────────────────────────────
// NOTIFICATIONS (global service, optionally shop-scoped)
// ─────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  dedupeKey String?
  shopId    String?
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  metadata  Json? // e.g. { orderLineItemId, discountPct } for a BELOW_FLOOR_DISCOUNT alert
  createdAt DateTime         @default(now())

  shop       Shop?                   @relation(fields: [shopId], references: [id])
  deliveries NotificationDelivery[]
  recipients NotificationRecipient[]

  @@index([shopId, isRead])
  @@index([dedupeKey])
  @@map("notifications")
}

// In-app read state belongs to a recipient, not to the shared notification.
// This prevents one owner reading an alert on behalf of every other owner.
model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt])
  @@map("notification_recipients")
}

// One row controls the authenticated user's delivery channels. Event-specific
// switches can be added later without changing the delivery/outbox design.
model NotificationPreference {
  id              String    @id @default(uuid())
  userId          String    @unique
  enabled         Boolean   @default(true)
  inAppEnabled    Boolean   @default(true)
  whatsappEnabled Boolean   @default(false)
  smsEnabled      Boolean   @default(false)
  whatsappOptInAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Durable outbox and audit record. BullMQ jobs carry only this row's ID, so
// phone numbers and message contents are not copied into Redis.
model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  userId            String
  channel           NotificationChannel
  destination       String?
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attempts          Int                        @default(0)
  lastError         String?
  queuedAt          DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  scheduledFor      DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId, channel])
  @@index([status, scheduledFor, createdAt])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

// Channel ownership belongs to the user. Provider secrets are stored only as
// authenticated ciphertext and are never returned by the API.
model UserNotificationChannel {
  id                    String                      @id @default(uuid())
  userId                String
  channel               NotificationChannel
  enabled               Boolean                     @default(false)
  destination           String?
  credentialsCiphertext String?
  configuration         Json?
  lastTestedAt          DateTime?
  lastTestStatus        NotificationDeliveryStatus?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([userId, enabled])
  @@map("user_notification_channels")
}

model NotificationTemplate {
  id                   String                     @id @default(uuid())
  userId               String
  name                 String
  channel              NotificationChannel
  providerTemplateName String?
  languageCode         String                     @default("en")
  message              String
  status               NotificationTemplateStatus @default(ACTIVE)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, channel])
  @@index([userId, status])
  @@map("notification_templates")
}
